# 測試專用環境（jest 的 setupFiles 先載 .env 再用這份覆蓋）。只有測試資料庫，沒有任何正式密碼。
# DB_NAME 一定要以 _test 結尾——tests/setup-env.js 會檢查，避免測試打到正式庫。
# DB_PASSWORD 故意不放：本機沿用 .env 的（或設 TEST_DB_PASSWORD），CI 由 workflow 提供。
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Schedule_test
DB_USER=postgres
DB_POOL_MAX=5

SECRET=test-secret-do-not-use-in-production-0123456789
JWT_SECRET=test-secret-do-not-use-in-production-0123456789
NODE_ENV=test
LOG_LEVEL=silent
PORT=0

ALLOWED_ORIGINS=https://erucmoney.com,http://localhost:3000
# 股票代理：測試時指到測試內起的假上游（tests/helpers/stock-upstream.js 會在執行期改寫這個值）
STOCK_API_URL=http://stock-upstream.test
STOCK_API_TIMEOUT_MS=2000
STOCK_API_LONG_TIMEOUT_MS=3000
# 整套平台共用的 admin：這個帳號註冊／登入時自動升成 admin
ADMIN_ACCOUNTS=t_admin
GLOBAL_RATE_LIMIT=10000
SOURCEIP=127.0.0.1
