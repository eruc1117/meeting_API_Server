DB_HOST=localhost
DB_PORT=5432
DB_NAME=Schedule
DB_USER=postgres
DB_PASSWORD=<your-db-password>
# JWT 密鑰：至少 32 字元隨機字串，backend 與 chatServer 必須使用同一組
# 產生方式：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRET=<your-random-secret-at-least-32-chars>
DATABASE_URL=postgres://postgres:<your-db-password>@localhost:5432/Schedule
SOURCEIP=127.0.0.1
POSTMAN=::1
AUTOTEST=::ffff:127.0.0.1
PORT=5000
